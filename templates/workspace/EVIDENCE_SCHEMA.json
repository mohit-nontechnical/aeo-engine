{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/answer-observation.schema.json",
  "title": "Consumer answer observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "run_id", "prompt_id", "registry_sha256", "engine", "product_label", "executed_at", "timezone", "locale", "language", "session_state", "exact_prompt", "validity", "answer_path", "screenshot_path", "answer_sha256", "screenshot_sha256", "cited_urls", "operator"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "prompt_id": {"type": "string", "pattern": "^SOL-[0-9]{3}$"},
    "registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "competitor_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "engine": {"enum": ["chatgpt", "perplexity", "bing-copilot", "google-ai"]},
    "product_label": {"type": "string", "minLength": 1},
    "account_tier": {"type": ["string", "null"]},
    "login_state": {"enum": ["logged-in", "logged-out", "unknown"]},
    "executed_at": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "minLength": 2},
    "language": {"type": "string", "minLength": 2},
    "country": {"type": ["string", "null"]},
    "device": {"type": ["string", "null"]},
    "browser": {"type": ["string", "null"]},
    "session_state": {"enum": ["clean", "unknown", "not-clean"]},
    "personalization_state": {"enum": ["off", "on", "unknown"]},
    "exact_prompt": {"type": "string", "minLength": 1},
    "validity": {"enum": ["valid", "invalid", "unavailable"]},
    "invalid_reason": {"type": ["string", "null"]},
    "answer_path": {"type": "string", "minLength": 1},
    "screenshot_path": {"type": "string", "minLength": 1},
    "answer_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "screenshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "client_mentioned": {"type": "boolean"},
    "client_mention_text": {"type": ["string", "null"]},
    "cited_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "operator": {"type": "string", "minLength": 1},
    "notes": {"type": ["string", "null"]}
  }
}
